        { "characterId": "char_111", "position": "center", "text": "効かないよ！…えっ、反射しきれない！？" },
        { "characterId": "char_019", "position": "right", "text": "今！そらの人！" },
        { "characterId": "char_018", "position": "left", "text": "うさぎさま！ぐぐ…ええーい！" },
